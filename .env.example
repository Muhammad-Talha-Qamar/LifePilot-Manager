# =============================================================================
# LifePilot — environment template
# =============================================================================
# Local setup:
#   cp .env.example .env
#   # or: npm run env:setup
#
# Then edit `.env` with real values. Never commit `.env`.
# Netlify: Site configuration → Environment variables (same keys).
# =============================================================================

# --- Demo auth (works without Supabase; recommended for Netlify demo) ----------
# Set both to "true" so browser + server use /api/auth for Create account / Sign in
LIFEPILOT_FORCE_DEMO=true
NEXT_PUBLIC_LIFEPILOT_FORCE_DEMO=true

# Signs session + demo roster cookies (use a long random string in production)
LIFEPILOT_SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase (optional) ------------------------------------------------------
# When ready for real multi-device accounts:
#   1) Set FORCE_DEMO flags above to false (or remove them)
#   2) Uncomment and fill these
#   3) Run supabase/migrations/001_initial_schema.sql on your project
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI (optional) --------------------------------------------------------
# If unset, LifePilot uses the built-in local rule-based agent
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Netlify Blobs (optional; auto-injected on Netlify) ------------------------
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
# NETLIFY_BLOBS_TOKEN=
