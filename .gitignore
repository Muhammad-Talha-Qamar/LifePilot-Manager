# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — never commit these (hundreds of MB)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output — never commit (rebuilds on Hostinger)
.next/
out/
dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# local demo data / agent junk
.demo-data.json
.demo-data/
.demo-users.json
.cursor/
